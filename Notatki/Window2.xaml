<Window x:Class="Notatki.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Notatki"
        mc:Ignorable="d"
        Title="Window2" Height="200" Width="200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock FontSize="18" VerticalAlignment="Center" TextAlignment="Center">Wpisz Nową Notatkę</TextBlock>
        <TextBox x:Name="note" FontSize="18" Margin="10" Grid.Row="1"></TextBox>
        <Button Grid.Row="2" Height="28" Width="150" VerticalAlignment="Center" FontSize="18" Click="Button_Click" >Dodaj Notatkę</Button>
    </Grid>
</Window>
